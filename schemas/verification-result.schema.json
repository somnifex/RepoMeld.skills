{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repomeld.dev/schemas/verification-result.schema.json",
  "title": "RepoMeld Verification Result",
  "type": "object",
  "required": ["status", "behavior_change", "api_change", "schema_change", "config_change", "dependency_change", "protected_paths", "checks", "gaps"],
  "properties": {
    "status": {"type": "string", "enum": ["verified", "failed", "incomplete"]},
    "behavior_change": {"type": "string", "enum": ["none_observed", "observed", "unknown"]},
    "api_change": {"type": "string", "enum": ["none_observed", "observed", "unknown"]},
    "schema_change": {"type": "string", "enum": ["none_observed", "observed", "unknown"]},
    "config_change": {"type": "string", "enum": ["none_observed", "observed", "unknown"]},
    "dependency_change": {"type": "string", "enum": ["none_observed", "observed", "unknown"]},
    "protected_paths": {"type": "string", "enum": ["untouched", "unexpected_modifications", "unknown"], "description": "Outcome of checking pre-existing/protected paths against the plan's protected_paths."},
    "task_preservation": {"type": "string", "enum": ["preserved", "violated", "unknown"], "description": "Outcome of checking the plan's deferred_tasks and their context carriers against the final diff."},
    "checks": {"type": "array", "items": {"type": "object"}},
    "suspicious_changes": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
