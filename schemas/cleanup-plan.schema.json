{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoMeld Cleanup Plan",
  "type": "object",
  "required": ["repository_root", "baseline", "shards", "actions", "escalations"],
  "properties": {
    "repository_root": {"type": "string"},
    "baseline": {"type": "object"},
    "execution_mode": {"type": "string", "enum": ["PARALLEL_NATIVE", "SEQUENTIAL_NATIVE", "PRIMARY_ONLY"]},
    "shards": {"type": "array", "items": {"type": "object", "required": ["id", "owned_paths"], "properties": {"id": {"type": "string"}, "owned_paths": {"type": "array", "items": {"type": "string"}}, "read_dependencies": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "actions": {"type": "array", "items": {"type": "object", "required": ["id", "path", "action", "risk", "owner", "reason"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "action": {"type": "string"}, "risk": {"type": "string"}, "owner": {"type": "string"}, "reason": {"type": "string"}, "verification": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "escalations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
