{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repomeld.dev/schemas/finding.schema.json",
  "title": "RepoMeld Finding",
  "type": "object",
  "required": ["id", "scope", "path", "category", "action", "risk", "confidence", "rationale"],
  "properties": {
    "id": {"type": "string"},
    "scope": {"type": "string"},
    "path": {"type": "string"},
    "line_start": {"type": ["integer", "null"], "minimum": 1},
    "line_end": {"type": ["integer", "null"], "minimum": 1},
    "category": {"type": "string", "enum": ["stage_marker", "agent_narration", "redundant_comment", "temporary_artifact", "stale_todo", "duplicated_rationale", "one_off_helper", "broken_reference", "missing_documentation", "contradictory_comment", "other"]},
    "action": {"type": "string", "enum": ["delete", "rewrite", "add", "preserve", "relocate", "escalate"]},
    "risk": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string"},
    "proposed_change": {"type": ["string", "null"]},
    "reference_evidence": {"type": "array", "items": {"type": "string"}},
    "requires_review": {"type": "boolean", "default": false},
    "task_status": {"type": "string", "enum": ["complete", "incomplete", "unknown"], "description": "Required for task-like findings; unknown is handled as incomplete. See references/task-completion-policy.md."},
    "completion_basis": {"type": "string", "enum": ["plan_artifact", "code_scan", "undetermined"]},
    "task_context": {"type": "array", "items": {"type": "string"}, "description": "Context carriers of a task-like finding: locations holding its intent, remaining work, constraints, continuation point, and related artifacts."},
    "context_preserved_at": {"type": ["string", "null"], "description": "Canonical location where a task's context was preserved when its original carrier was deleted or relocated."}
  },
  "additionalProperties": true
}
